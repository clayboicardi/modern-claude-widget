<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (API 30+). Only getLaunchIntentForPackage needs this: it is a
         package query, so Claude must be declared visible or it returns null. The deep-link,
         market:// and https launches are plain startActivity calls, which never need
         visibility, so no other package or intent is declared. -->
    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:icon="@drawable/cc_logo"
        android:label="@string/app_name">

        <receiver
            android:name=".ClaudeWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/claude_widget_info" />
        </receiver>
    </application>
</manifest>
